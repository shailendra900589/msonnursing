PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-secret-in-production
SITE_URL=https://msonnursing.com

# Hostinger hPanel → Databases → MySQL.
# Create the database and user there, then paste the values below.
# Leave MYSQL_HOST empty to keep using JSON files.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Production on Hostinger (hPanel → Node.js):
# Application root: this project folder
# Startup file: server.js
# Build command: npm run build
# Start command: npm start
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-domain.hostingersite.com
